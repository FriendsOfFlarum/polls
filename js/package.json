{
  "name": "@fof/polls",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "devDependencies": {
    "@flarum/jest-config": "^2.0.0",
    "@flarum/prettier-config": "^1.0.0",
    "@types/node": "^18.19.0",
    "body-scroll-lock": "^4.0.0-beta.0",
    "bootstrap": "^3.4.1",
    "clsx": "^1.1.1",
    "color-thief-browser": "^2.0.2",
    "dayjs": "^1.11.0",
    "flarum-tsconfig": "^2.0.0",
    "flarum-webpack-config": "^3.0.0",
    "focus-trap": "^6.7.1",
    "format-message": "^6.2.4",
    "jquery": "^3.7.0",
    "jquery.hotkeys": "^0.1.0",
    "mithril": "^2.2.0",
    "nanoid": "^3.3.18",
    "prettier": "^3.3.3",
    "punycode": "^2.1.1",
    "sortablejs": "^1.14.0",
    "textarea-caret": "^3.1.0",
    "throttle-debounce": "^3.0.1",
    "typescript": "^4.5.4",
    "typescript-coverage-report": "^0.6.1",
    "web-haptics": "^0.0.6",
    "webpack": "^5.65.0",
    "webpack-cli": "^4.9.1",
    "xslt-polyfill": "^1.0.21"
  },
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "analyze": "cross-env ANALYZER=true npm run build",
    "format": "prettier --write src",
    "format-check": "prettier --check src",
    "clean-typings": "npx rimraf dist-typings && mkdir dist-typings",
    "build-typings": "npm run clean-typings && ([ -e src/@types ] && cp -r src/@types dist-typings/@types || true) && tsc && npm run post-build-typings",
    "post-build-typings": "find dist-typings -type f -name '*.d.ts' -print0 | xargs -0 sed -i 's,../src/@types,@types,g'",
    "check-typings": "tsc --noEmit --emitDeclarationOnly false",
    "check-typings-coverage": "typescript-coverage-report",
    "test": "yarn node --experimental-vm-modules $(yarn bin jest)"
  },
  "prettier": "@flarum/prettier-config"
}
