{
  "name": "@fof/polls",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "devDependencies": {
    "@flarum/jest-config": "^2.0.2",
    "@flarum/prettier-config": "^1.0.0",
    "@types/jquery": "^3.5.34",
    "@types/mithril": "^2.2.9",
    "@types/node": "^24.19.1",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.23",
    "flat": "^6.0.1",
    "flarum-tsconfig": "^2.0.0",
    "flarum-webpack-config": "^3.0.6",
    "jest": "^29.7.0",
    "jquery": "^3.7.1",
    "js-yaml": "^5.4.3",
    "mithril": "^2.3.8",
    "mithril-query": "^4.0.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "analyze": "cross-env ANALYZER=true pnpm run build",
    "format": "prettier --write src",
    "format-check": "prettier --check src",
    "clean-typings": "pnpx rimraf dist-typings && mkdir dist-typings",
    "build-typings": "pnpm run clean-typings && ([ -e src/@types ] && cp -r src/@types dist-typings/@types || true) && tsc && pnpm run post-build-typings",
    "post-build-typings": "find dist-typings -type f -name '*.d.ts' -print0 | xargs -0 sed -i 's,../src/@types,@types,g'",
    "check-typings": "tsc --noEmit --emitDeclarationOnly false",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js"
  },
  "prettier": "@flarum/prettier-config",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "download",
      "version": "^12"
    }
  }
}
